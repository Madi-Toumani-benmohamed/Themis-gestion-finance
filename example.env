# ============================================================================
# thémis — example.env (SÉCURISÉ À COMMITTER)
# Copier en .env et adapter les valeurs selon ton environnement :
#   cp example.env .env
# Le .env est ignoré par Git (contient les vrais secrets).
# ============================================================================

# --- PostgreSQL (service db) ---
POSTGRES_IMAGE=themis-db:2.3
POSTGRES_USER=VOTRE_UTILISATEUR_POSTGRES
POSTGRES_PASSWORD=VOTRE_MOT_DE_PASSE_POSTGRES
POSTGRES_DB=themis
POSTGRES_PORT=5432

# --- Application (service app) ---
APP_PORT=8080
# DATABASE_URL construite à partir de POSTGRES_* ci-dessus
# Anthropic (IA)
ANTHROPIC_API_KEY=
# Ollama (IA locale)
OLLAMA_URL=
OLLAMA_MODEL=qwen2.5:14b

# --- Ollama (service optionnel, profile local-ai) ---
OLLAMA_IMAGE=ollama/ollama:latest
OLLAMA_PORT=11434

# --- Supabase (compose-supabase/) ---
# Connexion à une instance Supabase externe (au lieu du service db local)
SUPABASE_HOST=postgres.hmqzyokbcrdxboeizztb
SUPABASE_USER=postgres
SUPABASE_PASSWORD=VOTRE_MOT_DE PASSE_SUPABASE
SUPABASE_DB=postgres
SUPABASE_PORT=5432
SUPABASE_POOLER=aws-0-eu-central-1.pooler.supabase.com