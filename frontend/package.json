{
  "name": "solde-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test:browser": "node tests/transactions.browser.cjs && node tests/budgets.browser.cjs && node tests/simulation.browser.cjs && node tests/analysis.browser.cjs && node tests/credits.browser.cjs && node tests/ai-configuration.browser.cjs && node tests/statements.browser.cjs && node tests/import-fidelity.browser.cjs && npm run test:motion && npm run test:cinematic",
    "test:cinematic": "node tests/cinematic.browser.cjs",
    "test:motion": "node tests/motion.browser.cjs",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:report": "playwright show-report",
    "test:e2e:local": "bash tests/e2e/run-local.sh"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.2.8",
    "@fontsource/archivo": "^5.2.8",
    "@fontsource/fraunces": "^5.2.9",
    "@fontsource/ibm-plex-mono": "^5.2.7",
    "@fontsource/inter": "^5.2.8",
    "motion": "14.6.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.12.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@vitejs/plugin-react": "^6.1.2",
    "vite": "^8.3.4"
  }
}
