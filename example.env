# ============================================================================
# thémis — example.env (SÉCURISÉ À COMMITTER)
# Copier en .env et adapter les valeurs selon ton environnement :
#   cp example.env .env
# Le .env est ignoré par Git (contient les vrais secrets).
# ============================================================================

# --- PostgreSQL (service db) ---
POSTGRES_IMAGE=themis-db:2.3
POSTGRES_USER=VOTRE_UTILISATEUR_POSTGRES
POSTGRES_PASSWORD=VOTRE_MOT_DE_PASSE_POSTGRES
POSTGRES_DB=themis
POSTGRES_PORT=5432

# --- Application (service app) ---
APP_PORT=8080
# DATABASE_URL construite à partir de POSTGRES_* ci-dessus
# OpenAI (optionnel ; également configurable dans Admin)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Anthropic (IA)
ANTHROPIC_API_KEY=
# Ollama (IA locale)
# Variable legacy - préférer REMOTE_OLLAMA_BASE_URL
OLLAMA_URL=
OLLAMA_MODEL=qwen2.5:14b
# URL Ollama distante (Mac hôte). Laisser vide pour utiliser le conteneur local (profile local-ai).
# Exemple : http://host.docker.internal:11434
# Le compose ajoute automatiquement /v1 pour le Knowledge Graph.
REMOTE_OLLAMA_BASE_URL=

# --- Ollama (service optionnel, profile local-ai) ---
OLLAMA_IMAGE=ollama/ollama:latest
OLLAMA_PORT=11434

# --- Knowledge Graph (Graphiti + FalkorDB) ---
# Active le service de graphe de connaissances financières
MEMORY_ENABLED=true
# URL interne du service KG (dans Docker)
MEMORY_SERVICE_URL=http://knowledge-graph:8100
# FalkorDB
FALKORDB_IMAGE=falkordb/falkordb:latest
# Modèle d'embedding pour Ollama (doit être pullé : ollama pull nomic-embed-text)
OLLAMA_EMBED_MODEL=nomic-embed-text

# --- Supabase (compose-supabase/) ---
# Connexion à une instance Supabase externe (au lieu du service db local)
SUPABASE_HOST=postgres.hmqzyokbcrdxboeizztb
SUPABASE_USER=postgres
SUPABASE_PASSWORD=VOTRE_MOT_DE PASSE_SUPABASE
SUPABASE_DB=postgres
SUPABASE_PORT=5432
SUPABASE_POOLER=aws-0-eu-central-1.pooler.supabase.com
# Serveurs IA privés supplémentaires autorisés : bases URL exactes séparées par
# des virgules, avec chemin et port (ex. http://serveur-ia:11434 ou /v1).
# OLLAMA_URL et FREELLM_URL effectives sont déjà autorisées. Les métadonnées et
# adresses link-local restent interdites. Ne jamais mettre de clé dans une URL.
AI_TRUSTED_ENDPOINTS=
# Optionnel : none, ollama, openai, anthropic, mistral, freellm ; vide = détection.
AI_PROVIDER=
AI_AUTO_CATEGORIZE=true
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest
FREELLM_API_KEY=
FREELLM_MODEL=auto:fast
FREELLM_URL=http://freellm.local:3001/v1
